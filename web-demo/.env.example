# Copy to .env. Local and production run the same compose.yaml; only these values differ.

# Local: plain HTTP through Caddy on port 80 (*.localhost resolves to 127.0.0.1).
APP_DOMAIN=http://localhost
SYNC_DOMAIN=http://sync.localhost
VITE_SYNC_URL=ws://sync.localhost

# Production: bare domain names make Caddy obtain TLS certificates.
# APP_DOMAIN=theadoc.example.com
# SYNC_DOMAIN=sync.theadoc.example.com
# VITE_SYNC_URL=wss://sync.theadoc.example.com

ACME_EMAIL=admin@example.com
OPENROUTER_API_KEY=sk-or-v1-change-me
OPENROUTER_MODEL=openai/gpt-5.6-terra
