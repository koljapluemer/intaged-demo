# Copy to .env. Local and production run the same compose.yaml; only these values differ.

# Local: plain HTTP through Caddy on port 80 (*.localhost resolves to 127.0.0.1).
APP_DOMAIN=http://localhost
SYNC_DOMAIN=http://sync.localhost
VITE_SYNC_URL=ws://sync.localhost

# Production: bare domain names make Caddy obtain TLS certificates.
# APP_DOMAIN=theadoc.example.com
# SYNC_DOMAIN=sync.theadoc.example.com
# VITE_SYNC_URL=wss://sync.theadoc.example.com

ACME_EMAIL=admin@example.com
# API keys only: which models run, in which order and with which settings is defined in server/models.ts.
# Optional free-tier Gemini chain before OpenRouter. When empty, generation is OpenRouter-only.
# Free-tier requests may be used by Google to improve its products; see README.md.
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=sk-or-v1-change-me
# Defaults to 1 with Gemini enabled and 2 in OpenRouter-only mode.
# MAX_CONCURRENT_GENERATIONS=1

# Local machine only: SSH target of the server, used by `just pull-runs` to copy its run logs into llm-runs/.
# THEADOC_SSH=deploy@203.0.113.10

# Secret for the admin link /admin#<token>, which unlocks creating documents. Generate with: openssl rand -hex 32
ADMIN_TOKEN=change-me
