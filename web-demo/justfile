set dotenv-load := true

# Build and (re)start the stack. Same command locally and in production; .env picks the domains.
up:
    test -f .env || { echo "missing .env: cp .env.example .env" >&2; exit 1; }
    mkdir -p data
    docker compose up -d --build --remove-orphans

# Start the stack locally, whatever domains .env holds, and wait until the app is healthy.
dev:
    test -f .env || { echo "missing .env: cp .env.example .env" >&2; exit 1; }
    mkdir -p data
    APP_DOMAIN=http://localhost SYNC_DOMAIN=http://sync.localhost VITE_SYNC_URL=ws://sync.localhost ACME_EMAIL=dev@localhost \
        docker compose up -d --build --remove-orphans --wait
    @echo "app running at http://localhost"

down:
    docker compose down --remove-orphans

logs:
    docker compose logs -f

# Copy the generation run logs into llm-runs/: from the server (THEADOC_SSH in .env) and from local runs (data/runs).
pull-runs:
    mkdir -p llm-runs/server llm-runs/local
    if [ -z "${THEADOC_SSH:-}" ]; then echo "THEADOC_SSH not set: skipping server logs" >&2; \
    elif ssh "$THEADOC_SSH" test -d theadoc/web-demo/data/runs; then rsync -az "$THEADOC_SSH:theadoc/web-demo/data/runs/" llm-runs/server/; \
    else echo "no run logs on the server yet (data/runs appears after the first generation on a version with RUN_LOG_DIR)" >&2; fi
    if [ -d data/runs ]; then rsync -a data/runs/ llm-runs/local/; fi

# Lint and test inside the image build, on the same toolchain that ships.
check:
    docker build --target check .
